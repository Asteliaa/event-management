# Локальный запуск (npm run dev): строка подключения к PostgreSQL
DATABASE_URL=postgres://eventhub:change_me@127.0.0.1:5432/eventhub
# true – для управляемых облачных баз, требующих SSL
DB_SSL=false
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
PORT=3000
# Адреса клиента для CORS (через запятую)
CLIENT_URL=http://localhost:5173
# Адрес клиента для ссылок в письмах (восстановление пароля); по умолчанию – первый адрес CLIENT_URL
APP_URL=http://localhost:5173
# SMTP для писем восстановления пароля. Пусто – письма не отправляются.
# Разработка: Mailpit (docker run --rm -p 127.0.0.1:1025:1025 -p 127.0.0.1:8025:8025 axllent/mailpit:v1.27.1),
# письма видны на http://localhost:8025 и никуда не уходят. Реальный провайдер для деплоя не выбран
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EventHub <no-reply@eventhub.local>
# Ограничения восстановления пароля: запросов с одного IP за 15 минут и писем на один адрес за час
RESET_RATE_LIMIT_IP=10
RESET_RATE_LIMIT_EMAIL=3
# Как часто проверять напоминания, мс
REMINDER_INTERVAL_MS=30000
# Учетная запись администратора, которую создает npm run seed (демо)
SEED_ADMIN_EMAIL=admin@demo.eventhub.local
SEED_ADMIN_PASSWORD=admin12345

# Тесты (npm test): отдельная база, имя обязано оканчиваться на _test – она очищается при каждом запуске
TEST_DATABASE_URL=postgres://eventhub:test_only@127.0.0.1:5434/eventhub_test

# Docker Compose (docker-compose.yml): в контейнерах DATABASE_URL собирается из этих значений
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=change_me
POSTGRES_DB=eventhub

# Локальный запуск (npm run dev): MongoDB Atlas или локальная MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/eventhub
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
PORT=3000
# Адреса клиента для CORS (через запятую)
CLIENT_URL=http://localhost:5173
# Как часто проверять напоминания, мс
REMINDER_INTERVAL_MS=30000
# Учетная запись администратора, которую создает npm run seed
SEED_ADMIN_EMAIL=admin@events.local
SEED_ADMIN_PASSWORD=admin12345

# Docker Compose (docker-compose.yml): в контейнерах MONGO_URI собирается из этих значений
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me
# Вход в mongo-express (http://localhost:8081)
ME_USER=admin
ME_PASSWORD=change_me

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/event_management?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
PORT=3000
CLIENT_URL=http://localhost:5173
# Учетная запись администратора, которую создает npm run seed
SEED_ADMIN_EMAIL=admin@events.local
SEED_ADMIN_PASSWORD=admin12345

# ЛР8, Docker Compose (docker-compose.yml): в контейнерах MONGO_URI собирается из этих значений.
# Реальные пароли пишите только в .env (он в .gitignore), здесь только образец
# и указывает на сервис mongo, строка Atlas выше там не используется
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me
# Вход в mongo-express (http://localhost:8081)
ME_USER=admin
ME_PASSWORD=change_me

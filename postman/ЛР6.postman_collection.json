          "raw": "{\n  \"title\": \"Хакатон по веб-разработке\",\n  \"type\": \"conference\",\n  \"date\": \"2026-12-20\",\n  \"capacity\": 3,\n  \"description\": \"Командные соревнования\",\n  \"location\": {\n    \"city\": \"Минск\",\n    \"venue\": \"Коворкинг\"\n  },\n  \"tags\": [\n    \"IT\",\n    \"хакатон\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
